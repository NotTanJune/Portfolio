{
  "name": "portfolio-fullstack",
  "version": "1.0.0",
  "description": "Full-stack portfolio application",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "cd backend && bun run start",
    "start:backend": "cd backend && bun run start",
    "start:frontend": "cd frontend && bun run start",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run start",
    "install:all": "bun install && bun run --parallel install:backend install:frontend install:worker",
    "install:backend": "cd backend && bun install",
    "install:worker": "cd worker && bun install",
    "install:frontend": "cd frontend && bun install",
    "prepare": "husky",
    "build:frontend": "bun run optimize-images && cd frontend && bun run build",
    "optimize-images": "bun scripts/optimize-images.ts frontend/public/images",
    "deploy": "bash scripts/deploy.sh",
    "purge-cdn": "curl -fsS -X POST \"https://api.cloudflare.com/client/v4/zones/$CLOUDFLARE_ZONE_ID/purge_cache\" -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" -H \"Content-Type: application/json\" --data '{\"purge_everything\":true}'",
    "test:images": "bun test scripts/optimize-images.test.ts",
    "test:worker": "cd worker && bun test",
    "city:snapshot": "bun scripts/city-snapshot.ts",
    "city:emblems": "bun scripts/city-emblems.ts",
    "heroku-postbuild": "bun run --parallel install:backend install:frontend && bun run build:frontend"
  },
  "devDependencies": {
    "husky": "^9.1.6"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "framer-motion": "^12.23.22",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.11",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "typescript": "^5.9.3"
  },
  "author": "Tanmay Nargas",
  "license": "MIT"
}
