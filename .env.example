# MongoDB Atlas connection string
MONGODB_URI=

# Canonical public site origin used for CORS
CLIENT_URL=https://tanmaynargas.com

# Gmail account that sends contact form notifications (use an app password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Cloudflare Turnstile server-side secret
TURNSTILE_SECRET_KEY=

# Frontend build-time Turnstile site key (set in frontend/.env or Heroku config)
REACT_APP_TURNSTILE_SITE_KEY=

# Port (Heroku sets this automatically)
PORT=3001

# Node environment
NODE_ENV=development

# Optional: GitHub token for the repo city (raises the API rate limit).
# Use a fine-grained token with read-only access to PUBLIC repositories only.
# GITHUB_TOKEN=
